# Cleware temperature sensors (0d50:0010 USB-Temp, 0011 and 0015 USB-Temp2/5, 0020 humidity sensor):
# let the monitoring user read/write /dev/usb/hiddevN (check_cleware_temp).
# Adapt GROUP to the group of your monitoring core (e.g. nagios, naemon, or the OMD site name).
SUBSYSTEM=="usbmisc", KERNEL=="hiddev*", ATTRS{idVendor}=="0d50", ATTRS{idProduct}=="0010|0011|0015|0020", GROUP="monitoring", MODE="0660"
